"""CNF encoding of integer linear rows lo <= sum c_i x_i <= hi over Boolean x.

Each row becomes a decision diagram on partial sums. Node (k, s) means "the
first k terms sum to s and the row can still be satisfied". With
minrest/maxrest the extreme sums of terms k.., a node is
  FALSE if s + minrest > hi or s + maxrest < lo,
  TRUE  if lo <= s + minrest and s + maxrest <= hi,
otherwise it branches on x_k to (k+1, s + c_k) and (k+1, s). Clauses
(one direction suffices):
  root;   node & x_k -> high;   node & ~x_k -> low;
where an edge into FALSE becomes (~node | ~x_k) or (~node | x_k), and an
edge into TRUE adds nothing. Any model restricted to x satisfies the row
(follow the path: every node on it is forced true, FALSE is never reached).
Conversely a satisfying x extends by setting each node to its truth value.
"""


class CNF:
    def __init__(self, nvars):
        self.nvars = nvars
        self.clauses = []
        self.labels = {}      # aux var -> (tag, k, s): 'first k terms of row tag sum to s'

    def new(self):
        self.nvars += 1
        return self.nvars

    def add_row(self, terms, lo, hi, tag=None):
        """terms: [(var (1-based), coeff)]. Returns number of aux vars added."""
        start = self.nvars
        n = len(terms)
        minrest = [0] * (n + 1); maxrest = [0] * (n + 1)
        for k in range(n - 1, -1, -1):
            c = terms[k][1]
            minrest[k] = minrest[k + 1] + min(c, 0)
            maxrest[k] = maxrest[k + 1] + max(c, 0)

        def kind(k, s):
            if s + minrest[k] > hi or s + maxrest[k] < lo:
                return False
            if lo <= s + minrest[k] and s + maxrest[k] <= hi:
                return True
            return None

        root = kind(0, 0)
        if root is True:
            return 0
        if root is False:
            self.clauses.append([])          # row unsatisfiable by itself
            return 0
        node = {(0, 0): self.new()}
        self.labels[node[(0, 0)]] = (tag, 0, 0)
        self.clauses.append([node[(0, 0)]])
        frontier = [0]
        for k in range(n):
            v, c = terms[k]
            nxt = set()
            for s in frontier:
                me = node[(k, s)]
                for lit, child in ((v, s + c), (-v, s)):
                    t = kind(k + 1, child)
                    if t is True:
                        continue
                    if t is False:
                        self.clauses.append([-me, -lit])
                        continue
                    if (k + 1, child) not in node:
                        node[(k + 1, child)] = self.new()
                        self.labels[node[(k + 1, child)]] = (tag, k + 1, child)
                        nxt.add(child)
                    self.clauses.append([-me, -lit, node[(k + 1, child)]])
            frontier = sorted(nxt)
        return self.nvars - start

    def dimacs(self):
        out = [f'p cnf {self.nvars} {len(self.clauses)}']
        out += [' '.join(map(str, c + [0])) for c in self.clauses]
        return '\n'.join(out) + '\n'
"""Certify every case of l1-cover.json at m = 1 and m = 2 (resumable).

One line per certificate in certs/results.jsonl; (case index, m) pairs
already recorded as LRAT_VERIFIED_CORE_UNSAT are skipped on restart.

  run018.py [--jobs J] [--core-seconds S] [--m 1 2]
"""
import argparse
import json
import sys
import time
from concurrent.futures import ProcessPoolExecutor, as_completed
from pathlib import Path

sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
CERTS = HERE / 'certs'


def job(arg):
    idx, case, m, core_seconds, test_seconds = arg
    import certify018
    t = time.time()
    try:
        r = certify018.certify(case, m, str(CERTS / f'l1-{idx:05d}-m{m}'), core_seconds, test_seconds)
    except Exception as e:  # recorded, never treated as a proof
        r = dict(status='ERROR', error=repr(e)[:300])
    r['job_wall'] = round(time.time() - t, 1)
    return dict(case=idx, m=m, part=case['part'], type=case['type'], **r)


def placement_key(case):
    return json.dumps(dict(part=case['part'], root=case['root'], Q=sorted(case['Q']), pair=sorted(case['pair'])),
                      sort_keys=True)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--jobs', type=int, default=6); ap.add_argument('--core-seconds', type=float, default=900)
    ap.add_argument('--test-seconds', type=float, default=5); ap.add_argument('--m', type=int, nargs='*', default=[1, 2])
    a = ap.parse_args()
    CERTS.mkdir(exist_ok=True)
    rows = json.loads((HERE / 'l1-cover.json').read_text())['rows']
    index = {(placement_key(r), r['type']): i for i, r in enumerate(rows)}
    log = CERTS / 'results.jsonl'
    done = set()

    def mark(r):
        if r['status'] != 'LRAT_VERIFIED_CORE_UNSAT':
            return
        base = rows[r['case']]
        for t, m in r.get('variants') or [[base['type'], r['m']]]:
            j = index.get((placement_key(base), t))
            if j is not None:
                done.add((j, m))

    if log.exists():
        for line in log.read_text().splitlines():
            mark(json.loads(line))
    # m = 1 and type 'none' first: their variants usually cover c0, c3 and m = 2
    order = {'none': 0, 'pm': 1, 'pp': 1, 'c0': 2, 'c3': 2}
    todo = sorted(((i, m) for m in a.m for i in range(len(rows))), key=lambda x: (x[1], order[rows[x[0]]['type']], x[0]))
    with ProcessPoolExecutor(a.jobs) as ex, log.open('a') as out:
        pending = {}
        it = iter(todo)
        while True:
            while len(pending) < 2 * a.jobs:
                nxt = next((t for t in it if t not in done), None)
                if nxt is None:
                    break
                i, m = nxt
                pending[ex.submit(job, (i, rows[i], m, a.core_seconds, a.test_seconds))] = nxt
            if not pending:
                break
            f = next(as_completed(list(pending)))
            pending.pop(f)
            r = f.result()
            out.write(json.dumps(r) + '\n')
            out.flush()
            mark(r)


if __name__ == '__main__':
    main()
