The internal options have their default value printed in brackets
after their description.  They can also be used in the form
'--<name>' which is equivalent to '--<name>=1' and in the form
'--no-<name>' which is equivalent to '--<name>=0'.  One can also
use 'true' instead of '1', 'false' instead of '0', as well as
numbers with positive exponent such as '1e3' instead of '1000'.

Alternatively option values can also be specified in the header
of the DIMACS file, e.g., 'c --elim=false', or through environment
variables, such as 'CADICAL_ELIM=false'.  The embedded options in
the DIMACS file have highest priority, followed by command line
options and then values specified through environment variables.

The input is read from '<input>' assumed to be in DIMACS format.
Incremental 'p inccnf' files are supported too with cubes at the end.
If '<proof>' is given then a DRAT proof is written to that file.

If '<input>' is missing then the solver reads from '<stdin>',
also if '-' is used as input path name '<input>'.  Similarly,

For incremental files each cube is solved in turn. The solver
stops at the first satisfied cube if there is one and uses that
one for the witness to print.  Conflict and decision limits are
applied to each individual cube solving call while '-P', '-L' and
'-t' remain global.  Only if all cubes were unsatisfiable the solver
prints the standard unsatisfiable solution line ('s UNSATISFIABLE').

By default the proof is stored in the binary DRAT format unless
the option '--no-binary' is specified or the proof is written
to '<stdout>' and '<stdout>' is connected to a terminal.

The input is assumed to be compressed if it is given explicitly
and has a '.gz', '.bz2', '.xz' or '.7z' suffix.  The same applies
to the output file.  In order to use compression and decompression
the corresponding utilities 'gzip', 'bzip', 'xz', and '7z' (depending
on the format) are required and need to be installed on the system.
The solver checks file type signatures though and falls back to
non-compressed file reading if the signature does not match.
import copy
import json
import tempfile
import unittest
from pathlib import Path

import reader018 as rd

FX = Path(__file__).resolve().parent / 'fixtures'
B = json.loads((FX / 'cap-1.json').read_text())
A = json.loads((FX / 'A-pp-m2.json').read_text())


def read(doc):
    with tempfile.TemporaryDirectory() as d:
        p = Path(d) / 'c.json'
        p.write_text(json.dumps(doc))
        return rd.read(p)


def mutated(base, f):
    doc = copy.deepcopy(base)
    f(doc)
    return doc


class TestReader018(unittest.TestCase):
    def test_fixtures_verify(self):
        for doc in (B, A):
            self.assertEqual(read(doc)['verdict'], 'CASE_ROWS_INFEASIBLE_VERIFIED')

    def bad(self, base, f):
        with self.assertRaises(rd.ReaderError):
            read(mutated(base, f))

    def test_variants_must_hold_row_by_row(self):
        # B's core uses no Q-weighted and no constant row: valid for every constant-only type and both m
        r = read(mutated(B, lambda d: d.update(variants=[[t, m] for t in ('none', 'c0', 'c3') for m in (1, 2)])))
        self.assertEqual(len(r['variants']), 6)
        # A's core uses Q-weighted rows: claiming the other magnitude must fail
        self.bad(A, lambda d: d.update(variants=[[d['case']['type'], 2], [d['case']['type'], 1]]))

    def test_rejects_variant_changing_pair_type(self):
        self.bad(A, lambda d: d.update(variants=[['pp', 2], ['pm', 2]]))

    def test_rejects_magnitude_three(self):
        self.bad(B, lambda d: d.update(magnitude=3))

    def test_rejects_moved_Q(self):
        self.bad(B, lambda d: d['case'].update(Q=[1, 2, 3, 6]))

    def test_rejects_wrong_type(self):
        self.bad(A, lambda d: d['case'].update(type='pm'))

    def test_rejects_degcap_outside_B_ord(self):
        def f(d):
            d['case']['part'] = 'B-exc'
        self.bad(B, f)

    def test_rejects_degcap_at_Q_vertex(self):
        def f(d):
            r = next(r for r in d['rows'] if r['key'][0] == 'degcap')
            r['key'][1] = d['case']['Q'][0]
        self.bad(B, f)

    def test_rejects_flag_rows_in_part_A(self):
        def f(d):
            d['rows'].append(dict(id=10 ** 6, key=['flag', 5, [6, 7, 8]], terms=[], lo=0, hi=0))
        self.bad(A, f)

    def test_rejects_root_in_Q(self):
        self.bad(B, lambda d: d['case'].update(Q=[0, 1, 2, 3]))

    def test_rejects_forged_vertex(self):
        def f(d):
            d['rows'][0]['key'] = ['vertex', 13]
        self.bad(B, f)


class TestReaderPaths(unittest.TestCase):
    """Row kinds the fixtures' cores do not contain, rebuilt and compared with model018."""

    def test_every_row_kind_matches_model018(self):
        import model018 as M
        cover = json.loads((FX.parent / 'l1-cover.json').read_text())['rows']
        for case in (next(r for r in cover if r['part'] == 'B-ord' and r['type'] == 'c3'),
                     next(r for r in cover if r['part'] == 'B-exc')):
            for mag in (1, 2):
                model, fixed = M.case_model(case, mag)
                names = model['variables']
                rc = rd.Case(case, mag)
                seen = set()
                for terms, lo, hi, key in model['rows']:
                    kind = key[0]
                    if kind in seen and kind not in ('vertex', 'implied_P', 'degcap'):
                        continue
                    seen.add(kind)
                    jkey = [kind] + [list(x) if isinstance(x, tuple) else x for x in key[1:]]
                    want, wlo, whi = rc.substituted(rd.parse_key(jkey))
                    shift = sum(co * fixed[names[v]] for v, co in terms if names[v] in fixed)
                    got = {(names[v][0], tuple(sorted(names[v][1]))): co for v, co in terms if names[v] not in fixed}
                    self.assertEqual((got, lo - shift, hi - shift), (want, wlo, whi), key)
                self.assertTrue({'constant', 'vertex', 'implied_P', 'implied_k', 'value', 'pair', 'triple', 'flag'} <= seen)
                if case['part'] == 'B-ord':
                    self.assertIn('degcap', seen)


class TestBinding(unittest.TestCase):
    def test_forged_root_metadata_is_not_bound(self):
        import read_all018
        doc = copy.deepcopy(B)
        cover = json.loads((FX.parent / 'l1-cover.json').read_text())['rows']
        real = read_all018.placement(doc['case'])
        self.assertIn(real, {read_all018.placement(c) for c in cover})
        doc['case']['root'] = {'kind': 'forged-catalog', 'index': 999999}
        self.assertNotIn(read_all018.placement(doc['case']), {read_all018.placement(c) for c in cover})


if __name__ == '__main__':
    unittest.main()
"""model018 rows against real derivatives (exact evaluation, no solver)."""
import itertools
import json
import unittest
from pathlib import Path

import model018 as M

HERE = Path(__file__).resolve().parent
CONTROLS = json.loads((HERE / 'controls-n13.json').read_text())['controls']


def assignment(ex, n):
    """Model for a real derivative: every non-baseline coefficient an exception or a weight."""
    pairs = {tuple(p): v for p, v in ex['pairs']}
    quads = {tuple(q): v for q, v in ex['quartics']}
    exc = {p: v for p, v in pairs.items() if v not in (-1, 0)}
    weights = {q: v for q, v in quads.items() if v not in (0, 1)}
    L = lambda S: sum(v for q, v in quads.items() if set(S) <= set(q))
    ints = [T for T in itertools.combinations(range(n), 3) if L(T) // 2 not in (0, 1)]
    model = M.build(exc, ex['constant'], ex['constant'], weights=weights, int_triples=ints, n=n)
    val = {}
    for q in itertools.combinations(range(n), 4):
        val[('l', frozenset(q))] = 1 if q in weights else quads.get(q, 0)
    for a in itertools.combinations(range(n), 2):
        k = pairs.get(a, 0)
        val[('m', frozenset(a))] = (k + L(a)) // 4
        if a not in exc:
            val[('kappa', frozenset(a))] = -k
    for T in itertools.combinations(range(n), 3):
        t = L(T) // 2
        if T in ints:
            b = t + 1
            val[('t', frozenset(T))], val[('t2', frozenset(T))], val[('t4', frozenset(T))] = b & 1, b >> 1 & 1, b >> 2 & 1
        else:
            val[('t', frozenset(T))] = t
    x = [val[nm] for nm in model['variables']]
    return model, x


def violated(model, x):
    return [key for terms, lo, hi, key in model['rows'] if not lo <= sum(c * x[v] for v, c in terms) <= hi]


class TestModel018(unittest.TestCase):
    def test_real_derivatives_satisfy_every_row(self):
        for r in CONTROLS:
            model, x = assignment(r['explicit'], 12)
            self.assertEqual(violated(model, x), [], r['witness'])

    def test_perturbed_derivative_fails(self):
        ex = dict(CONTROLS[0]['explicit'])
        ex['constant'] += 1
        model, x = assignment(ex, 12)
        self.assertNotEqual(violated(model, x), [])

    def test_case_model_shapes(self):
        cover = json.loads((HERE / 'l1-cover.json').read_text())['rows']
        case = next(r for r in cover if r['part'] == 'B-exc')
        model, fixed = M.case_model(case, 2)
        names = set(model['variables'])
        self.assertTrue(all(nm in names for nm in fixed))
        self.assertIn(('t4', frozenset(case['Q'][:3])), names)


