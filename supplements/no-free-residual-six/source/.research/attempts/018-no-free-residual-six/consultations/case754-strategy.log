import hashlib
import itertools
import json
import subprocess
import sys
from pathlib import Path

N = 13
LRAT_TRIM = Path(__file__).resolve().parents[1] / '006-solver-resume/lrat-trim/lrat-trim'
LRAT_TRIM_SHA = '179d041f645a98d51d3ca6dbbe4950806ad8eceb54c9a762f54e7acee154f8df'


class ReaderError(Exception):
    pass


def need(cond, detail):
    if not cond:
        raise ReaderError(detail)


def sha(p):
    return hashlib.sha256(Path(p).read_bytes()).hexdigest()


def name(kind, s):
    return (kind, tuple(sorted(s)))


class Case:
    TYPES = {'none': (1, 2), 'c0': (0, 0), 'c3': (3, 3), 'pm': (1, 2), 'pp': (1, 2)}

    def __init__(self, case, mag):
        need(type(mag) is int and mag in (1, 2), 'negative magnitude must be 1 or 2')
        need(case.get('part') in ('A', 'B-ord', 'B-exc') and case.get('type') in self.TYPES, 'bad part or type')
        self.part, self.type, self.mag = case['part'], case['type'], mag
        self.c_lo, self.c_hi = self.TYPES[self.type]
        self.Q = vset(sorted(case['Q']), 4)
        need(0 not in self.Q, 'root inside Q')
        pair = case['pair']
        self.exc = {}
        if self.type in ('pm', 'pp'):
            p = vset(sorted(pair), 2)
            self.exc[p] = -2 if self.type == 'pm' else 1
            self.pair = set(p)
        else:
            need(pair == [], 'departure pair given for a pairless type')
            self.pair = set()
        if self.part == 'B-exc':
            need(self.type in ('pm', 'pp') and 0 in self.pair and len(self.pair & set(self.Q)) <= 1, 'B-exc shape')
        if self.part == 'B-ord':
            need(not self.pair or self.pair <= set(self.Q), 'B-ord pair must lie inside Q')
        self.ints = set(itertools.combinations(self.Q, 3))
        faces = [vset(sorted(f) if isinstance(f, list) else f, 3) for f in case['faces']]
        need(len(set(faces)) == len(faces) and faces, 'root link faces')
        link = sorted(set(x for f in faces for x in f))
        need(0 not in link, 'root link labels')
        self.order = len(link)
        self.fixed = {name('m', (0, v)): int(v in link) for v in range(1, N)}
        fs = set(faces)
        for f in itertools.combinations(range(1, N), 3):
            self.fixed[name('l', (0,) + f)] = int(f in fs)
        self.fixed[name('l', self.Q)] = 1

    def lw(self, q):
        return -self.mag if tuple(sorted(q)) == self.Q else 1

    def k(self, pair, acc, coef):
        p = tuple(sorted(pair))
        if p in self.exc:
            return coef * self.exc[p]
        acc[name('kappa', p)] = acc.get(name('kappa', p), 0) - coef
        return 0

    def t(self, T, acc, coef):
        """Add coef * t_T; return the constant part."""
        T = tuple(sorted(T))
        acc[name('t', T)] = acc.get(name('t', T), 0) + coef
        if T in self.ints:
            acc[name('t2', T)] = acc.get(name('t2', T), 0) + 2 * coef
            acc[name('t4', T)] = acc.get(name('t4', T), 0) + 4 * coef
            return -coef
        return 0

    def row(self, key):
        kind, t, const = key[0], {}, 0
        V = range(N)
        if kind == 'pair':
            a, b = key[1]
            t[name('m', (a, b))] = 4
            for q in itertools.combinations(V, 4):
                if a in q and b in q:
                    t[name('l', q)] = -self.lw(q)
            const = self.k((a, b), t, -1)
            return t, -const, -const
        if kind == 'triple':
            T = set(key[1])
            for q in itertools.combinations(V, 4):
                if T <= set(q):
                    t[name('l', q)] = self.lw(q)
            const = self.t(T, t, -2)
            return t, -const, -const
        if kind in ('vertex', 'constant'):
            if kind == 'vertex':
                lo = hi = 8
                on = lambda s: key[1] in s
            else:
                lo, hi = 16 - self.c_hi, 16 - self.c_lo
                on = lambda s: True
            for a in itertools.combinations(V, 2):
                if on(a):
                    const += self.k(a, t, 1)
            for q in itertools.combinations(V, 4):
                if on(q):
                    t[name('l', q)] = self.lw(q)
            return t, lo - const, hi - const
        if kind == 'value':
            X = tuple(key[1])
            for a in itertools.combinations(X, 2):
                t[name('m', a)] = -1
            for T in itertools.combinations(X, 3):
                const += self.t(T, t, 1)
            for q in itertools.combinations(X, 4):
                t[name('l', q)] = -self.lw(q)
            return t, -len(X) - const, 2 - len(X) - const
        if kind == 'flag':
            v, (a, b, d) = key[1], key[2]
            need(self.part != 'A' and v != 0 and v not in self.Q and v not in self.pair,
                 'flag row at a vertex whose link need not be a deltahedron')
            for x, y in ((a, b), (b, d), (a, d)):
                const += self.t((v, x, y), t, 1)
            t[name('l', (v, a, b, d))] = -self.lw((v, a, b, d))
            return t, -10 ** 6 - const, 2 - const
        if kind == 'degcap':
            # B-ord roots at an ordinary vertex of maximum degree: D_v <= order of the root link
            v = key[1]
            need(self.part == 'B-ord' and v != 0 and v not in self.Q and v not in self.pair, 'degree cap outside its scope')
            for a in itertools.combinations(V, 2):
                if v in a:
                    t[name('m', a)] = 1
            return t, -10 ** 6, self.order
        if kind == 'implied_P':
            v = key[1]
            for q in itertools.combinations(V, 4):
                if v in q:
                    t[name('l', q)] = self.lw(q)
            for a in itertools.combinations(V, 2):
                if v in a:
                    t[name('m', a)] = -2
            return t, -4, -4
        if kind == 'implied_k':
            v, rhs = key[1], 12
            for a in itertools.combinations(V, 2):
                if v in a:
                    rhs -= self.k(a, t, 1)
                    t[name('m', a)] = t.get(name('m', a), 0) + 2
            return t, rhs, rhs
        raise ReaderError('unknown row kind ' + str(kind))

    def substituted(self, key):
        t, lo, hi = self.row(key)
        shift = sum(co * self.fixed[nm] for nm, co in t.items() if nm in self.fixed)
        return {nm: co for nm, co in t.items() if nm not in self.fixed and co}, lo - shift, hi - shift


def vertex(x):
    need(type(x) is int and 0 <= x < N, f'not a coordinate: {x!r}')
    return x


def vset(xs, size=None, min_size=None):
    need(isinstance(xs, list), 'vertex set must be a list')
    out = tuple(vertex(x) for x in xs)
    need(len(set(out)) == len(out) and list(out) == sorted(out), 'vertex set must be distinct and sorted')
    need(size is None or len(out) == size, 'wrong vertex-set size')
    need(min_size is None or len(out) >= min_size, 'vertex set too small')
    return out


def parse_key(k):
    """Strict schema: every vertex an int in 0..12, sets distinct and sorted, exact arity."""
    need(isinstance(k, list) and k and isinstance(k[0], str), 'bad key')
    kind = k[0]
    if kind in ('pair', 'triple'):
        need(len(k) == 2, 'bad key arity')
        return (kind, vset(k[1], 2 if kind == 'pair' else 3))
    if kind in ('vertex', 'implied_P', 'implied_k', 'degcap'):
        need(len(k) == 2, 'bad key arity')
        return (kind, vertex(k[1]))
    if kind == 'constant':
        need(len(k) == 1, 'bad key arity')
        return ('constant',)
    if kind == 'value':
        need(len(k) == 2, 'bad key arity')
        return ('value', vset(k[1], min_size=2))
    if kind == 'flag':
        need(len(k) == 3, 'bad key arity')
        v, abd = vertex(k[1]), vset(k[2], 3)
        need(v not in abd, 'flag triple contains its vertex')
        return ('flag', v, abd)
    raise ReaderError('unknown key ' + json.dumps(k))


SIZES = {'l': 4, 'm': 2, 't': 3, 'kappa': 2, 't2': 3, 't4': 3}


def parse_name(nm):
    need(isinstance(nm, list) and len(nm) == 2 and nm[0] in SIZES, 'bad variable name')
    return (nm[0], vset(nm[1], SIZES[nm[0]]))


def read_cnf(path):
    clauses, cur, header = [], [], None
    for line in open(path):
        t = line.split()
        if not t or t[0] == 'c':
            continue
        if t[0] == 'p':
            header = (int(t[2]), int(t[3]))
            continue
        for x in map(int, t):
            if x == 0:
                clauses.append(cur)
                cur = []
            else:
                cur.append(x)
    need(not cur and header is not None and header[1] == len(clauses), 'malformed CNF')
    return header[0], clauses


def check_clauses(rows, nbase, nvars, clauses, labels):
    lab = {}
    for v, r, k, s in labels:
        need(nbase < v <= nvars and v not in lab and 0 <= r < len(rows) and 0 <= k <= len(rows[r][0]), f'bad label {v}')
        lab[v] = (r, k, s)
    rest = []
    for terms, lo, hi in rows:
        mn, mx = [0] * (len(terms) + 1), [0] * (len(terms) + 1)
        for k in range(len(terms) - 1, -1, -1):
            mn[k] = mn[k + 1] + min(terms[k][1], 0)
            mx[k] = mx[k + 1] + max(terms[k][1], 0)
        rest.append((mn, mx))
    for cl in clauses:
        if not cl:
            need(any(rest[r][0][0] > rows[r][2] or rest[r][1][0] < rows[r][1] for r in range(len(rows))),
                 'unjustified empty clause')
            continue
        if len(cl) == 1 and cl[0] in lab and lab[cl[0]][1:] == (0, 0):
            continue
        need(len(cl) in (2, 3) and cl[0] < 0 and -cl[0] in lab, f'unrecognized clause {cl[:4]}')
        r, k, s = lab[-cl[0]]
        terms, lo, hi = rows[r]
        need(k < len(terms), 'step past end')
        v, c = terms[k]
        lit = -cl[1]
        need(abs(lit) == v, 'clause literal is not term k of its row')
        s2 = s + (c if lit > 0 else 0)
        if len(cl) == 3:
            need(cl[2] in lab and lab[cl[2]] == (r, k + 1, s2), 'bad step clause')
            continue
        mn, mx = rest[r]
        need(s2 + mn[k + 1] > hi or s2 + mx[k + 1] < lo, 'unjustified dead-end clause')


def read(cert_path):
    cert = json.loads(Path(cert_path).read_text())
    case = Case(cert['case'], cert['magnitude'])
    variants = cert.get('variants', [[cert['case']['type'], cert['magnitude']]])
    need(isinstance(variants, list) and [cert['case']['type'], cert['magnitude']] in variants
         and len({tuple(v) for v in variants}) == len(variants), 'bad variant list')
    others = []
    for t, mg in variants:
        need(t in Case.TYPES and (t == cert['case']['type'] or {t, cert['case']['type']} <= {'none', 'c0', 'c3'}),
             'variant changes more than the constant-only type')
        if [t, mg] != [cert['case']['type'], cert['magnitude']]:
            others.append(Case(dict(cert['case'], type=t), mg))
    for k in ('cnf', 'labels', 'proof'):
        need(sha(cert[k]['path']) == cert[k]['sha256'], k + ' changed')
    names = [parse_name(nm) for nm in cert['variables']]
    need(len(set(names)) == len(names), 'duplicate variable names')
    index = {nm: i + 1 for i, nm in enumerate(names)}
    rows = []
    for i, r in enumerate(cert['rows']):
        want, lo, hi = case.substituted(parse_key(r['key']))
        for other in others:
            need(other.substituted(parse_key(r['key'])) == (want, lo, hi), f'row {i} differs between variants')
        got = {}
        terms = []
        for nm, co in r['terms']:
            nm = parse_name(nm)
            need(nm not in got and type(co) is int and co, 'aliased or zero term')
            got[nm] = co
            terms.append((index[nm], co))
        need(got == want and (r['lo'], r['hi']) == (lo, hi), f'row {i} differs from its definition')
        rows.append((terms, lo, hi))
    nvars, clauses = read_cnf(cert['cnf']['path'])
    labels = json.loads(Path(cert['labels']['path']).read_text())
    # labels carry the certifier's row ids; map them to positions in the stored list
    pos = {r['id']: i for i, r in enumerate(cert['rows'])}
    need(len(pos) == len(cert['rows']), 'duplicate row ids')
    labels = [[v, pos[r], k, s] for v, r, k, s in labels]
    check_clauses(rows, len(names), nvars, clauses, labels)
    need(sha(LRAT_TRIM) == LRAT_TRIM_SHA, 'checker changed')
    p = subprocess.run([str(LRAT_TRIM), '--forward', '--no-trim', cert['cnf']['path'], cert['proof']['path']],
                       capture_output=True, text=True)
    ok = p.returncode == 20 and any(line.strip() == 's VERIFIED' for line in p.stdout.splitlines())
    return dict(part=case.part, type=case.type, Q=list(case.Q), magnitude=case.mag, variants=variants, rows=len(rows), clauses=len(clauses), clause_soundness='PASS',
                lrat_trim_exit=p.returncode, verdict='CASE_ROWS_INFEASIBLE_VERIFIED' if ok else 'NOT_VERIFIED')


if __name__ == '__main__':
    r = read(sys.argv[1])
    print(json.dumps(r))
    sys.exit(0 if r['verdict'] == 'CASE_ROWS_INFEASIBLE_VERIFIED' else 1)
"""Assembly check for L1: every cover case, at m = 1 and m = 2, has a verified certificate.

Runs reader018.read on every certificate in certs/ (l1-*-m1.json, l1-*-m2.json),
then requires, for each case of l1-cover.json and each m in {1,2}, a reader-
verified certificate whose stored case equals the cover case in every field
except possibly the type, and whose verified variant list contains
(the cover case's type, m). Runs cover_reader018 on the cover (unless --skip-cover
is given with the hash of a previous pass) and binds the result to the
frontier rows (2^4) and (2^4,1) of no-free-frontier.json.

  read_all018.py OUT_JSON [--jobs J]
"""
import hashlib
import json
import sys
from concurrent.futures import ProcessPoolExecutor
from pathlib import Path

sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
sys.path.insert(0, str(HERE.parent / '017-type-ii-three-exception'))
import reader018  # noqa: E402


def sha(p):
    return hashlib.sha256(Path(p).read_bytes()).hexdigest()


def one(path):
    try:
        r = reader018.read(path)
    except Exception as e:
        return dict(path=str(path), verdict='REJECTED', error=repr(e)[:300])
    cert = json.loads(Path(path).read_text())
    return dict(path=str(path), sha256=sha(path), verdict=r['verdict'], variants=r['variants'], case=cert['case'],
                rows=r['rows'], clauses=r['clauses'],
                files={k: dict(path=cert[k]['path'], sha256=cert[k]['sha256']) for k in ('cnf', 'labels', 'proof')})


def placement(case):
    """Every field except the type, in normal form."""
    d = {k: v for k, v in case.items() if k != 'type'}
    d['Q'], d['pair'] = sorted(d['Q']), sorted(d['pair'])
    d['faces'] = sorted(sorted(f) for f in d['faces'])
    return json.dumps(d, sort_keys=True)


def main(out, jobs=6):
    certs = sorted(p for p in (HERE / 'certs').glob('l1-*-m[12].json'))
    with ProcessPoolExecutor(jobs) as ex:
        results = list(ex.map(one, certs, chunksize=8))
    ok = set()
    for r in results:
        if r['verdict'] == 'CASE_ROWS_INFEASIBLE_VERIFIED':
            for t, m in r['variants']:
                ok.add((placement(r['case']), t, m))
    cover = json.loads((HERE / 'l1-cover.json').read_text())
    import cover_reader018
    cov = cover_reader018.read(cover)
    missing = [dict(case=i, m=m) for i, c in enumerate(cover['rows']) for m in (1, 2)
               if (placement(c), c['type'], m) not in ok]
    frontier = json.loads((HERE / 'no-free-frontier.json').read_text())
    targets = [r for r in frontier['rows'] if r['negative_magnitudes'] in ([2, 2, 2, 2], [2, 2, 2, 2, 1])]
    doc = dict(status='ALL_L1_CASES_VERIFIED' if not missing and cov['status'] == 'L1_COVER_READER_PASS' else 'INCOMPLETE',
               cover=dict(path=str(HERE / 'l1-cover.json'), sha256=sha(HERE / 'l1-cover.json')),
               cover_reader=dict(status=cov['status'], cases=cov['cases']),
               reader=dict(path=str(HERE / 'reader018.py'), sha256=sha(HERE / 'reader018.py')),
               frontier=dict(path=str(HERE / 'no-free-frontier.json'), sha256=sha(HERE / 'no-free-frontier.json')),
               target_inventories=[r['negative_magnitudes'] for r in targets],
               certificates=len(results),
               rejected=[r for r in results if r['verdict'] != 'CASE_ROWS_INFEASIBLE_VERIFIED'],
               missing=missing[:200], missing_count=len(missing), results=results)
    Path(out).write_text(json.dumps(doc) + '\n')
    print(json.dumps(dict(status=doc['status'], certificates=len(results), rejected=len(doc['rejected']),
                          missing=len(missing))))
    return doc


if __name__ == '__main__':
    main(sys.argv[1], int(sys.argv[3]) if len(sys.argv) > 3 and sys.argv[2] == '--jobs' else 6)
"""Case cover for the one-incident-departure lemma (L1) at a delta = 1 coordinate.

A derivative p = Delta_u f on 13 coordinates with one negative quartic Q
(l_Q = -m, m in {1,2}) and at most one incident cost-2 departure:
none (constant in {1,2}); constant 0; constant 3; or a pair numerator -2 or
+1 (constant in {1,2}). (+2 quartic departures are excluded by the private
-vertex lemma, NOTES.md.) Ordinary vertex: outside Q and the departure pair.

Parts (root always labelled 0, never in Q):
  B-ord  all ordinary links are spheres; root an ordinary vertex, link a
         deltahedron (1..n), non-neighbours n+1..12. Types: none, c0, c3,
         and pairs inside Q.
  B-exc  all ordinary links are spheres; the pair has an endpoint x outside
         Q; root x, link the type (1,0) sphere (-2) or the type (0,1) sphere
         (+1) from the 017 catalog, partner y its degree-6 or degree-3 vertex.
         Types: pairs meeting Q in 0 or 1 vertex (y in Q or not).
  A      some ordinary vertex has a disconnected link: root there, link two
         six-vertex projective planes on 1..6 and 7..12. Every type.
Reductions: automorphisms of the root link fixing the special structure, and
relabelling of non-neighbours; each orbit is generated explicitly and its
least member kept.
"""
import itertools
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
C017 = HERE.parent / '017-type-ii-three-exception'
sys.path.insert(0, str(C017))
import cases as c017  # noqa: E402

N = 13
LABELS = list(range(1, N))


def deltahedra():
    return json.loads((C017 / 'deltahedra.json').read_text())['spheres']


def rp2_pair():
    import surfaces
    (rp,) = surfaces.brute(6, 1).values()
    rp = sorted(sorted(f) for f in rp)
    return rp, [[x + 1 for x in f] for f in rp] + [[x + 7 for x in f] for f in rp]


def auts_rp2_pair(rp):
    one = c017.automorphisms([[x + 1 for x in f] for f in rp])
    out = []
    for a, b in itertools.product(one, one):
        mp = {**a, **{x + 6: b[x] + 6 for x in b}}
        out.append(mp)
        out.append({x: (mp[x] + 6 if mp[x] <= 6 else mp[x] - 6) for x in mp})
    return out


def normal(Q, P, order):
    """Relabel non-neighbours (> order) by first use in (sorted Q, sorted P)."""
    ren, nxt = {}, order + 1
    for x in sorted(Q) + sorted(P):
        if x > order and x not in ren:
            ren[x] = nxt
            nxt += 1
    return tuple(sorted(ren.get(x, x) for x in Q)), tuple(sorted(ren.get(x, x) for x in P))


def orbits(placements, auts, order):
    """Least member of each orbit; every orbit generated explicitly."""
    seen, reps = set(), []
    for Q, P in placements:
        key = normal(Q, P, order)
        if key in seen:
            continue
        orbit = {normal([a.get(x, x) for x in key[0]], [a.get(x, x) for x in key[1]], order) for a in auts}
        seen |= orbit
        reps.append(min(orbit))
    return sorted(reps)


def placements_B_ord(order, meet):
    for Q in itertools.combinations(LABELS, 4):
        if meet is None:
            yield Q, ()
        else:
            for P in itertools.combinations(Q, 2):
                yield Q, P


def cover():
    rows = []
    for li, d in enumerate(deltahedra()):
        auts = c017.automorphisms(d['faces'])
        for t, meet in (('none', None), ('c0', None), ('c3', None), ('pm', 2), ('pp', 2)):
            for Q, P in orbits(list(placements_B_ord(d['order'], meet)), auts, d['order']):
                rows.append(dict(part='B-ord', root=dict(kind='deltahedron', index=li), order=d['order'],
                                 faces=d['faces'], type=t, Q=list(Q), pair=list(P)))
    cat = json.loads((C017 / 'roots-catalog.json').read_text())['catalog']
    for t, key, deg in (('pm', '1,0', 6), ('pp', '0,1', 3)):
        for li, r in enumerate(cat[key]):
            faces, order = r['faces'], r['order']
            dg = c017.degrees(faces)
            (y,) = [v for v in dg if dg[v] == deg]
            auts = [a for a in c017.automorphisms(faces) if a[y] == y]
            for meet in (0, 1):
                pl = [(Q, ()) for Q in itertools.combinations(LABELS, 4) if (y in Q) == (meet == 1)]
                for Q, _ in orbits(pl, auts, order):
                    rows.append(dict(part='B-exc', root=dict(kind='catalog-' + key, index=li), order=order,
                                     faces=faces, type=t, Q=list(Q), pair=[0, y]))
    rp, faces = rp2_pair()
    auts = auts_rp2_pair(rp)
    for t, meet in (('none', None), ('c0', None), ('c3', None)) + tuple((k, j) for k in ('pm', 'pp') for j in (0, 1, 2)):
        pl = []
        for Q in itertools.combinations(LABELS, 4):
            if meet is None:
                pl.append((Q, ()))
                continue
            for P in itertools.combinations(LABELS, 2):
                if len(set(P) & set(Q)) == meet:
                    pl.append((Q, P))
        for Q, P in orbits(pl, auts, 12):
            rows.append(dict(part='A', root=dict(kind='rp2-pair', index=0), order=12, faces=faces, type=t,
                             Q=list(Q), pair=list(P)))
    return dict(status='L1_CASE_COVER', rows=rows)


def main(out):
    doc = cover()
    Path(out).write_text(json.dumps(doc) + '\n')
    from collections import Counter
    print(json.dumps(Counter((r['part'], r['type']) for r in doc['rows']).most_common()), len(doc['rows']))


if __name__ == '__main__':
    main(sys.argv[1])
"""Independent check of l1-cover.json. Shares no code with cases018.py.

For each part and departure type the lemma needs (B-ord: none, c0, c3 and a
pair inside Q; B-exc: a pair meeting Q in 0 or 1 vertex, rooted at its
endpoint outside Q; A: every type), and each root link of that part, it
enumerates every labelled placement of Q (4 labels in 1..12) and the
departure pair, computes the root link's automorphisms by backtracking on
the face set (components handled separately), and requires each placement to
equal a listed case after some automorphism and some permutation of the
non-neighbour labels. It also checks every listed case is a valid placement
of its part and type, and that the root links are the catalog spheres.
"""
import itertools
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
C017 = HERE.parent / '017-type-ii-three-exception'
N = 13
LAB = list(range(1, N))


class CoverError(Exception):
    pass


def need(cond, detail):
    if not cond:
        raise CoverError(detail)


def auts(faces, fixed=()):
    """All permutations of the link vertices preserving the face set (and fixing `fixed`)."""
    fs = {tuple(sorted(f)) for f in faces}
    vs = sorted({x for f in fs for x in f})
    adj = {v: set() for v in vs}
    for f in fs:
        for a, b in itertools.combinations(f, 2):
            adj[a].add(b)
            adj[b].add(a)
    order, left = [], set(vs)
    while left:                                   # BFS order per component
        s = min(left)
        comp, frontier = [s], [s]
        left.discard(s)
        while frontier:
            nxt = sorted(w for v in frontier for w in adj[v] if w in left)
            for w in nxt:
                if w in left:
                    left.discard(w)
                    comp.append(w)
            frontier = nxt
        order += comp
    out = []

    def ext(mp):
        if len(mp) == len(vs):
            if {tuple(sorted(mp[x] for x in f)) for f in fs} == fs:
                out.append(dict(mp))
            return
        v = order[len(mp)]
        for w in vs:
            if w in mp.values() or len(adj[w]) != len(adj[v]) or (v in fixed and w != v):
                continue
            if all((mp[u] in adj[w]) == (u in adj[v]) for u in mp):
                mp[v] = w
                ext(mp)
                del mp[v]

    ext({})
    return out


def placements(part, typ, order, y=None):
    pairs = typ in ('pm', 'pp')
    for Q in itertools.combinations(LAB, 4):
        if part == 'B-exc':
            if (y in Q) == (typ_meet(typ) == 1):
                yield frozenset(Q), frozenset((0, y))
            continue
        if not pairs:
            yield frozenset(Q), frozenset()
            continue
        for P in itertools.combinations(LAB, 2):
            if part == 'B-ord' and not set(P) <= set(Q):
                continue
            yield frozenset(Q), frozenset(P)


def typ_meet(typ):
    return CURRENT_MEET[0]


CURRENT_MEET = [None]


def match(p, have, group, order):
    Q, P = p
    for a in group:
        aQ = [a.get(x, x) for x in Q]
        aP = [a.get(x, x) for x in P]
        fr = sorted({x for x in aQ + aP if x > order})
        for perm in itertools.permutations(range(order + 1, N), len(fr)):
            ren = dict(zip(fr, perm))
            if (frozenset(ren.get(x, x) for x in aQ), frozenset(ren.get(x, x) for x in aP)) in have:
                return True
    return False


def read(cover):
    deltas = json.loads((C017 / 'deltahedra.json').read_text())['spheres']
    cat = json.loads((C017 / 'roots-catalog.json').read_text())['catalog']
    rows = cover['rows']
    listed = {}
    for r in rows:
        need(r['part'] in ('A', 'B-ord', 'B-exc') and r['type'] in ('none', 'c0', 'c3', 'pm', 'pp'), 'part/type')
        Q, P = frozenset(r['Q']), frozenset(r['pair'])
        need(len(Q) == 4 and 0 not in Q and all(1 <= x <= 12 for x in Q), 'Q labels')
        need((len(P) == 2) == (r['type'] in ('pm', 'pp')) and (not P or len(P) == 2), 'pair')
        if r['part'] == 'B-ord':
            need(r['root']['kind'] == 'deltahedron' and deltas[r['root']['index']]['faces'] == r['faces'], 'root')
            need(P <= Q, 'B-ord pair inside Q')
        elif r['part'] == 'B-exc':
            key = '1,0' if r['type'] == 'pm' else '0,1'
            need(r['root']['kind'] == 'catalog-' + key and cat[key][r['root']['index']]['faces'] == r['faces'], 'root')
            need(0 in P and len(P & Q) <= 1, 'B-exc pair')
        else:
            need(r['root']['kind'] == 'rp2-pair' and r['order'] == 12, 'root')
        meet = len(P & Q) if P else None
        listed.setdefault((r['part'], r['type'], r['root']['index'], meet), set()).add((Q, P))
    report = []
    # B-ord
    for i, d in enumerate(deltas):
        need(all(sum(1 for f in d['faces'] if x in f) in (4, 5) for x in range(1, d['order'] + 1)), 'not a deltahedron')
        g = auts(d['faces'])
        for typ in ('none', 'c0', 'c3', 'pm', 'pp'):
            meet = 2 if typ in ('pm', 'pp') else None
            have = listed.get(('B-ord', typ, i, meet), set())
            cnt = 0
            for p in placements('B-ord', typ, d['order']):
                cnt += 1
                need(match(p, have, g, d['order']), f'B-ord {typ} root {i} uncovered')
            report.append(('B-ord', typ, i, cnt, len(have)))
    # B-exc
    for typ, key, deg in (('pm', '1,0', 6), ('pp', '0,1', 3)):
        for i, r in enumerate(cat[key]):
            dg = {x: sum(1 for f in r['faces'] if x in f) for x in range(1, r['order'] + 1)}
            ys = [x for x in dg if dg[x] == deg]
            need(len(ys) == 1 and all(dg[x] in (4, 5) for x in dg if x not in ys), 'catalog sphere degrees')
            y = ys[0]
            g = auts(r['faces'], fixed=(y,))
            for meet in (0, 1):
                CURRENT_MEET[0] = meet
                have = listed.get(('B-exc', typ, i, meet), set())
                cnt = 0
                for p in placements('B-exc', typ, r['order'], y):
                    cnt += 1
                    need(match(p, have, g, r['order']), f'B-exc {typ} root {i} meet {meet} uncovered')
                report.append(('B-exc', typ, i, meet, cnt, len(have)))
    # A
    a_rows = [r for r in rows if r['part'] == 'A']
    need(a_rows, 'no part A cases')
    faces = a_rows[0]['faces']
    need(all(r['faces'] == faces for r in a_rows), 'part A root links differ')
    comps = [sorted({x for f in faces for x in f if x <= 6}), sorted({x for f in faces for x in f if x > 6})]
    need(comps == [list(range(1, 7)), list(range(7, 13))] and len(faces) == 20, 'part A root shape')
    import surfaces  # 017 brute-force closed surfaces: each component must be the six-vertex RP2
    sys.path.insert(0, str(C017))
    for comp in comps:
        sub = [f for f in faces if set(f) <= set(comp)]
        lab = {x: i for i, x in enumerate(comp)}
        need(surfaces.is_closed_surface(frozenset(frozenset(lab[x] for x in f) for f in sub))
             and surfaces.euler(frozenset(frozenset(lab[x] for x in f) for f in sub)) == 1, 'part A component')
    g = auts(faces)
    for typ in ('none', 'c0', 'c3', 'pm', 'pp'):
        for meet in ((None,) if typ in ('none', 'c0', 'c3') else (0, 1, 2)):
            have = listed.get(('A', typ, 0, meet), set())
            cnt = 0
            for Q in itertools.combinations(LAB, 4):
                Ps = [()] if meet is None else [P for P in itertools.combinations(LAB, 2) if len(set(P) & set(Q)) == meet]
                for P in Ps:
                    cnt += 1
                    need(match((frozenset(Q), frozenset(P)), have, g, 12), f'A {typ} meet {meet} uncovered')
            report.append(('A', typ, meet, cnt, len(have)))
    return dict(status='L1_COVER_READER_PASS', cases=len(rows), checks=report)


if __name__ == '__main__':
    sys.path.insert(0, str(C017))
    r = read(json.loads(Path(sys.argv[1]).read_text()))
    print(json.dumps(dict(status=r['status'], cases=r['cases'], groups=len(r['checks']))))

