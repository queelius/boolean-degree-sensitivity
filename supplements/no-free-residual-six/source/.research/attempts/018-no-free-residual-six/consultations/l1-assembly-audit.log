    92	        emit(acc, const, 8, 8, ('vertex', v))
    93	    acc, const = {}, 0
    94	    for a in pairs:
    95	        const += add_k(acc, a, 1)
    96	    for q in quads:
    97	        add_l(acc, q, 1)
    98	    emit(acc, const, 16 - c_hi, 16 - c_lo, ('constant',))
    99	    for size in range(2, n + 1):
   100	        for X in itertools.combinations(V, size):
   101	            xs = frozenset(X)
   102	            acc, const = {}, 0
   103	            for a in pairs:
   104	                if a <= xs:
