   120	            return t, -const, -const
   121	        if kind == 'triple':
   122	            T = set(key[1])
   123	            for q in itertools.combinations(V, 4):
   124	                if T <= set(q):
   125	                    t[name('l', q)] = self.lw(q)
   126	            const = self.t(T, t, -2)
   127	            return t, -const, -const
   128	        if kind in ('vertex', 'constant'):
   129	            if kind == 'vertex':
   130	                lo = hi = 8
   131	                on = lambda s: key[1] in s
   132	            else:
   133	                lo, hi = 16 - self.c_hi, 16 - self.c_lo
   134	                on = lambda s: True
   135	            for a in itertools.combinations(V, 2):
   136	                if on(a):
   137	                    const += self.k(a, t, 1)
   138	            for q in itertools.combinations(V, 4):
   139	                if on(q):
   140	                    t[name('l', q)] = self.lw(q)
   141	            return t, lo - const, hi - const
   142	        if kind == 'value':
   143	            X = tuple(key[1])
   144	            for a in itertools.combinations(X, 2):
   145	                t[name('m', a)] = -1
   146	            for T in itertools.combinations(X, 3):
   147	                const += self.t(T, t, 1)
   148	            for q in itertools.combinations(X, 4):
   149	                t[name('l', q)] = -self.lw(q)
   150	            return t, -len(X) - const, 2 - len(X) - const
   151	        if kind == 'flag':
   152	            v, (a, b, d) = key[1], key[2]
   153	            need(self.part != 'A' and v != 0 and v not in self.Q and v not in self.pair,
   154	                 'flag row at a vertex whose link need not be a deltahedron')
   155	            for x, y in ((a, b), (b, d), (a, d)):
   156	                const += self.t((v, x, y), t, 1)
   157	            t[name('l', (v, a, b, d))] = -self.lw((v, a, b, d))
   158	            return t, -10 ** 6 - const, 2 - const
   159	        if kind == 'degcap':
   160	            # B-ord roots at an ordinary vertex of maximum degree: D_v <= order of the root link
   161	            v = key[1]
   162	            need(self.part == 'B-ord' and v != 0 and v not in self.Q and v not in self.pair, 'degree cap outside its scope')
   163	            for a in itertools.combinations(V, 2):
   164	                if v in a:
   165	                    t[name('m', a)] = 1
   166	            return t, -10 ** 6, self.order
   167	        if kind == 'implied_P':
   168	            v = key[1]
   169	            for q in itertools.combinations(V, 4):
   170	                if v in q:
