    32	    pairs = [frozenset(p) for p in itertools.combinations(V, 2)]
    33	    triples = [frozenset(t) for t in itertools.combinations(V, 3)]
    34	    quads = [frozenset(q) for q in itertools.combinations(V, 4)]
    35	    weights = {frozenset(q): w for q, w in dict(weights).items()}
    36	    ints = {frozenset(t) for t in int_triples}
    37	    exc = {frozenset(p): k for p, k in dict(exceptions).items()}
    38	    names = ([('l', q) for q in quads] + [('m', a) for a in pairs] + [('t', t) for t in triples]
    39	             + [('kappa', a) for a in pairs if a not in exc]
    40	             + [(nm, t) for t in sorted(ints, key=sorted) for nm in ('t2', 't4')])
    41	    index = {v: i for i, v in enumerate(names)}
    42	    rows = []
    43	
    44	    def emit(acc, const, lo, hi, key):
    45	        terms = sorted((index[nm], co) for nm, co in acc.items() if co)
    46	        rows.append((terms, lo - const, hi - const, key))
    47	
    48	    def add(acc, nm, co):
    49	        acc[nm] = acc.get(nm, 0) + co
    50	
    51	    def add_l(acc, q, co):
