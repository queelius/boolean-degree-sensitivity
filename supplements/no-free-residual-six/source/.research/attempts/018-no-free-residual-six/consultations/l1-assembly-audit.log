     2	import itertools
     3	import json
     4	import unittest
     5	from pathlib import Path
     6	
     7	import model018 as M
     8	
     9	HERE = Path(__file__).resolve().parent
    10	CONTROLS = json.loads((HERE / 'controls-n13.json').read_text())['controls']
    11	
    12	
    13	def assignment(ex, n):
    14	    """Model for a real derivative: every non-baseline coefficient an exception or a weight."""
    15	    pairs = {tuple(p): v for p, v in ex['pairs']}
    16	    quads = {tuple(q): v for q, v in ex['quartics']}
    17	    exc = {p: v for p, v in pairs.items() if v not in (-1, 0)}
    18	    weights = {q: v for q, v in quads.items() if v not in (0, 1)}
    19	    L = lambda S: sum(v for q, v in quads.items() if set(S) <= set(q))
    20	    ints = [T for T in itertools.combinations(range(n), 3) if L(T) // 2 not in (0, 1)]
    21	    model = M.build(exc, ex['constant'], ex['constant'], weights=weights, int_triples=ints, n=n)
    22	    val = {}
    23	    for q in itertools.combinations(range(n), 4):
    24	        val[('l', frozenset(q))] = 1 if q in weights else quads.get(q, 0)
    25	    for a in itertools.combinations(range(n), 2):
    26	        k = pairs.get(a, 0)
    27	        val[('m', frozenset(a))] = (k + L(a)) // 4
    28	        if a not in exc:
    29	            val[('kappa', frozenset(a))] = -k
    30	    for T in itertools.combinations(range(n), 3):
    31	        t = L(T) // 2
    32	        if T in ints:
    33	            b = t + 1
    34	            val[('t', frozenset(T))], val[('t2', frozenset(T))], val[('t4', frozenset(T))] = b & 1, b >> 1 & 1, b >> 2 & 1
    35	        else:
    36	            val[('t', frozenset(T))] = t
    37	    x = [val[nm] for nm in model['variables']]
    38	    return model, x
    39	
    40	
    41	def violated(model, x):
    42	    return [key for terms, lo, hi, key in model['rows'] if not lo <= sum(c * x[v] for v, c in terms) <= hi]
    43	
    44	
    45	class TestModel018(unittest.TestCase):
    46	    def test_real_derivatives_satisfy_every_row(self):
    47	        for r in CONTROLS:
    48	            model, x = assignment(r['explicit'], 12)
    49	            self.assertEqual(violated(model, x), [], r['witness'])
    50	
    51	    def test_perturbed_derivative_fails(self):
    52	        ex = dict(CONTROLS[0]['explicit'])
    53	        ex['constant'] += 1
    54	        model, x = assignment(ex, 12)
    55	        self.assertNotEqual(violated(model, x), [])
