   205	def parse_key(k):
   206	    """Strict schema: every vertex an int in 0..12, sets distinct and sorted, exact arity."""
   207	    need(isinstance(k, list) and k and isinstance(k[0], str), 'bad key')
   208	    kind = k[0]
   209	    if kind in ('pair', 'triple'):
   210	        need(len(k) == 2, 'bad key arity')
   211	        return (kind, vset(k[1], 2 if kind == 'pair' else 3))
   212	    if kind in ('vertex', 'implied_P', 'implied_k', 'degcap'):
   213	        need(len(k) == 2, 'bad key arity')
   214	        return (kind, vertex(k[1]))
   215	    if kind == 'constant':
   216	        need(len(k) == 1, 'bad key arity')
   217	        return ('constant',)
   218	    if kind == 'value':
   219	        need(len(k) == 2, 'bad key arity')
   220	        return ('value', vset(k[1], min_size=2))
   221	    if kind == 'flag':
   222	        need(len(k) == 3, 'bad key arity')
   223	        v, abd = vertex(k[1]), vset(k[2], 3)
   224	        need(v not in abd, 'flag triple contains its vertex')
   225	        return ('flag', v, abd)
   226	    raise ReaderError('unknown key ' + json.dumps(k))
