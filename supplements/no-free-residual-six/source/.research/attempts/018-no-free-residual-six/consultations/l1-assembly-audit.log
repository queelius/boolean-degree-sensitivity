# Every packet's tests (from ATTEMPT.json), both modes, each with its own interpreter
.research/venv-exact/bin/python -B .research/tools/attempts.py test --jobs 2   # about 30 min
.research/venv-exact/bin/python -B .research/tools/attempts.py test 018 --normal-only
.research/venv-exact/bin/python -B .research/tools/attempts.py validate && .research/venv-exact/bin/python -B .research/tools/attempts.py index --check

# Consult Codex (read-only; prompt, answer, log and record land in <attempt>/consultations/)
.research/venv-exact/bin/python -B .research/tools/consult_codex.py .research/attempts/018-no-free-residual-six l1-assembly-audit prompt.md --effort max

# no-three-in-line CLI
uv run python -m math_theory.no_three_in_line verify-known
