   237	def read_cnf(path):
   238	    clauses, cur, header = [], [], None
   239	    for line in open(path):
   240	        t = line.split()
   241	        if not t or t[0] == 'c':
   242	            continue
   243	        if t[0] == 'p':
   244	            header = (int(t[2]), int(t[3]))
   245	            continue
   246	        for x in map(int, t):
   247	            if x == 0:
   248	                clauses.append(cur)
   249	                cur = []
   250	            else:
   251	                cur.append(x)
   252	    need(not cur and header is not None and header[1] == len(clauses), 'malformed CNF')
   253	    return header[0], clauses
