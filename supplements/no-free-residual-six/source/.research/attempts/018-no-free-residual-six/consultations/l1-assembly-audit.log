    41	def placement(case):
    42	    """Every field except the type, in normal form."""
    43	    d = {k: v for k, v in case.items() if k != 'type'}
    44	    d['Q'], d['pair'] = sorted(d['Q']), sorted(d['pair'])
    45	    d['faces'] = sorted(sorted(f) for f in d['faces'])
    46	    return json.dumps(d, sort_keys=True)
