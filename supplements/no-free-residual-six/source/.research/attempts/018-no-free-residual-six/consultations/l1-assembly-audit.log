   154	               rows=[dict(id=k, key=jkey(m['rows'][k][3]),
   155	                          terms=[[jname(m['variables'][v]), co] for v, co in m['rows'][k][0]],
   156	                          lo=m['rows'][k][1], hi=m['rows'][k][2]) for k in keep],
   157	               core_initial=len(core),
   158	               cnf=dict(path=str(cnf_path), sha256=sha(cnf_path), variables=cnf.nvars, clauses=len(cnf.clauses)),
   159	               labels=dict(path=str(labels_path), sha256=sha(labels_path)),
   160	               solver='UNSAT' if rc == 20 else f'rc{rc}', solve_wall=t_solve)
