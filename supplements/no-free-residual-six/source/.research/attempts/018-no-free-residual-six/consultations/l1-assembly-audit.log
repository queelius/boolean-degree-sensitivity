   256	def check_clauses(rows, nbase, nvars, clauses, labels):
   257	    lab = {}
   258	    for v, r, k, s in labels:
   259	        need(nbase < v <= nvars and v not in lab and 0 <= r < len(rows) and 0 <= k <= len(rows[r][0]), f'bad label {v}')
   260	        lab[v] = (r, k, s)
   261	    rest = []
   262	    for terms, lo, hi in rows:
   263	        mn, mx = [0] * (len(terms) + 1), [0] * (len(terms) + 1)
   264	        for k in range(len(terms) - 1, -1, -1):
   265	            mn[k] = mn[k + 1] + min(terms[k][1], 0)
   266	            mx[k] = mx[k + 1] + max(terms[k][1], 0)
   267	        rest.append((mn, mx))
   268	    for cl in clauses:
   269	        if not cl:
   270	            need(any(rest[r][0][0] > rows[r][2] or rest[r][1][0] < rows[r][1] for r in range(len(rows))),
   271	                 'unjustified empty clause')
   272	            continue
   273	        if len(cl) == 1 and cl[0] in lab and lab[cl[0]][1:] == (0, 0):
   274	            continue
   275	        need(len(cl) in (2, 3) and cl[0] < 0 and -cl[0] in lab, f'unrecognized clause {cl[:4]}')
   276	        r, k, s = lab[-cl[0]]
   277	        terms, lo, hi = rows[r]
   278	        need(k < len(terms), 'step past end')
   279	        v, c = terms[k]
   280	        lit = -cl[1]
   281	        need(abs(lit) == v, 'clause literal is not term k of its row')
   282	        s2 = s + (c if lit > 0 else 0)
   283	        if len(cl) == 3:
   284	            need(cl[2] in lab and lab[cl[2]] == (r, k + 1, s2), 'bad step clause')
   285	            continue
   286	        mn, mx = rest[r]
   287	        need(s2 + mn[k + 1] > hi or s2 + mx[k + 1] < lo, 'unjustified dead-end clause')
