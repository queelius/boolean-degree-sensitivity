   143	
   144	def root_fixings(root, link_faces, n=N):
   145	    nbrs = set().union(*[set(f) for f in link_faces])
   146	    out = {('m', frozenset((root, v))): int(v in nbrs) for v in range(n) if v != root}
   147	    faces = {frozenset(f) for f in link_faces}
   148	    for f in itertools.combinations([v for v in range(n) if v != root], 3):
   149	        out[('l', frozenset(f) | {root})] = int(frozenset(f) in faces)
   150	    return out
   151	
   152	
   153	def case_model(case, m):
   154	    """Model and fixings for one cover case at negative magnitude m."""
   155	    Q = frozenset(case['Q'])
   156	    t = case['type']
   157	    exc = {}
   158	    if t in ('pm', 'pp'):
   159	        exc[frozenset(case['pair'])] = -2 if t == 'pm' else 1
   160	    c_lo, c_hi = {'none': (1, 2), 'c0': (0, 0), 'c3': (3, 3)}.get(t, (1, 2))
   161	    special = set(Q) | set(case['pair'])
   162	    flags = [] if case['part'] == 'A' else [v for v in range(1, N) if v not in special]
   163	    # in part B-ord the root is an ordinary vertex of maximum degree (L1.md), so every
   164	    # other ordinary vertex has degree at most the root link's order
   165	    cap = (case['order'], flags) if case['part'] == 'B-ord' else None
   166	    model = build(exc, c_lo, c_hi, weights={Q: -m}, flag_vertices=flags, degree_cap=cap,
   167	                  int_triples=[frozenset(T) for T in itertools.combinations(sorted(Q), 3)])
   168	    fixed = root_fixings(0, case['faces'])
   169	    fixed[('l', Q)] = 1
   170	    return model, fixed

