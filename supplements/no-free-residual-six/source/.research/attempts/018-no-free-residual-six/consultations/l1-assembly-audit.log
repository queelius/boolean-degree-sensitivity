   290	def read(cert_path):
   291	    cert = json.loads(Path(cert_path).read_text())
   292	    case = Case(cert['case'], cert['magnitude'])
   293	    variants = cert.get('variants', [[cert['case']['type'], cert['magnitude']]])
   294	    need(isinstance(variants, list) and [cert['case']['type'], cert['magnitude']] in variants
   295	         and len({tuple(v) for v in variants}) == len(variants), 'bad variant list')
   296	    others = []
   297	    for t, mg in variants:
   298	        need(t in Case.TYPES and (t == cert['case']['type'] or {t, cert['case']['type']} <= {'none', 'c0', 'c3'}),
   299	             'variant changes more than the constant-only type')
   300	        if [t, mg] != [cert['case']['type'], cert['magnitude']]:
   301	            others.append(Case(dict(cert['case'], type=t), mg))
   302	    for k in ('cnf', 'labels', 'proof'):
   303	        need(sha(cert[k]['path']) == cert[k]['sha256'], k + ' changed')
   304	    names = [parse_name(nm) for nm in cert['variables']]
   305	    need(len(set(names)) == len(names), 'duplicate variable names')
   306	    index = {nm: i + 1 for i, nm in enumerate(names)}
   307	    rows = []
   308	    for i, r in enumerate(cert['rows']):
   309	        want, lo, hi = case.substituted(parse_key(r['key']))
   310	        for other in others:
   311	            need(other.substituted(parse_key(r['key'])) == (want, lo, hi), f'row {i} differs between variants')
   312	        got = {}
   313	        terms = []
   314	        for nm, co in r['terms']:
   315	            nm = parse_name(nm)
   316	            need(nm not in got and type(co) is int and co, 'aliased or zero term')
   317	            got[nm] = co
   318	            terms.append((index[nm], co))
   319	        need(got == want and (r['lo'], r['hi']) == (lo, hi), f'row {i} differs from its definition')
   320	        rows.append((terms, lo, hi))
   321	    nvars, clauses = read_cnf(cert['cnf']['path'])
   322	    labels = json.loads(Path(cert['labels']['path']).read_text())
   323	    # labels carry the certifier's row ids; map them to positions in the stored list
   324	    pos = {r['id']: i for i, r in enumerate(cert['rows'])}
   325	    need(len(pos) == len(cert['rows']), 'duplicate row ids')
   326	    labels = [[v, pos[r], k, s] for v, r, k, s in labels]
   327	    check_clauses(rows, len(names), nvars, clauses, labels)
   328	    need(sha(LRAT_TRIM) == LRAT_TRIM_SHA, 'checker changed')
   329	    p = subprocess.run([str(LRAT_TRIM), '--forward', '--no-trim', cert['cnf']['path'], cert['proof']['path']],
   330	                       capture_output=True, text=True)
   331	    ok = p.returncode == 20 and any(line.strip() == 's VERIFIED' for line in p.stdout.splitlines())
   332	    return dict(part=case.part, type=case.type, Q=list(case.Q), magnitude=case.mag, variants=variants, rows=len(rows), clauses=len(clauses), clause_soundness='PASS',
   333	                lrat_trim_exit=p.returncode, verdict='CASE_ROWS_INFEASIBLE_VERIFIED' if ok else 'NOT_VERIFIED')
   334	
   335	
   336	if __name__ == '__main__':
   337	    r = read(sys.argv[1])
   338	    print(json.dumps(r))
   339	    sys.exit(0 if r['verdict'] == 'CASE_ROWS_INFEASIBLE_VERIFIED' else 1)

