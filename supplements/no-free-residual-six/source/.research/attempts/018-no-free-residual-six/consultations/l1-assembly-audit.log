   110	    def row(self, key):
   111	        kind, t, const = key[0], {}, 0
   112	        V = range(N)
   113	        if kind == 'pair':
   114	            a, b = key[1]
   115	            t[name('m', (a, b))] = 4
   116	            for q in itertools.combinations(V, 4):
   117	                if a in q and b in q:
   118	                    t[name('l', q)] = -self.lw(q)
