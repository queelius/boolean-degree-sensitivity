   196	def vset(xs, size=None, min_size=None):
   197	    need(isinstance(xs, list), 'vertex set must be a list')
   198	    out = tuple(vertex(x) for x in xs)
   199	    need(len(set(out)) == len(out) and list(out) == sorted(out), 'vertex set must be distinct and sorted')
   200	    need(size is None or len(out) == size, 'wrong vertex-set size')
   201	    need(min_size is None or len(out) >= min_size, 'vertex set too small')
   202	    return out
